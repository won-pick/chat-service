{
  "info": {
    "name": "Chat 메시지 API 실습",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "최신 API: 메시지 전송에 Idempotency-Key 필수. 자동 변수는 새 전송마다 새 키를 생성합니다. 재시도 테스트에는 같은 고정 키를 입력하세요. 실제 인증·Market·Trade 연동은 미정입니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "roomId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. 채팅방 생성 (응답 id를 roomId 변수에 입력)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 10,\n  \"buyerId\": 1,\n  \"sellerId\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. 구매자 메시지 전송",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": 1,\n  \"content\": \"아직 판매 중인가요?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. 판매자 답장",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": 2,\n  \"content\": \"네, 판매 중입니다.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. 판매자로 대화 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages?memberId=2"
      }
    },
    {
      "name": "5. 비참여자 조회 거절 (403)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages?memberId=3"
      }
    },
    {
      "name": "6. 빈 메시지 거절 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": 1,\n  \"content\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. 내 채팅방과 안 읽은 수",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms?memberId=2",
        "header": []
      }
    },
    {
      "name": "8. 읽음 처리",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/read-position",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberId\": 2,\n  \"lastReadMessageId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. 내 읽은 위치",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/read-position?memberId=2",
        "header": []
      }
    },
    {
      "name": "10. 상대 읽은 위치",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/read-position/peer?memberId=1",
        "header": []
      }
    },
    {
      "name": "11. 방 상세 (참여자 검사)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}?memberId=1",
        "header": []
      }
    }
  ]
}