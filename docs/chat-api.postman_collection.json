{
  "info": {
    "name": "Chat 메시지 API 실습",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Apidog/Postman Chat 핵심 흐름. 방 생성과 판매자 답장의 응답 ID를 자동 변수로 저장합니다. 전송에 Idempotency-Key가 필수이며 재시도 테스트에는 같은 고정 키를 사용하세요. 인증·Market·Trade 호출은 실습 Chat 범위에 아직 없습니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "roomId",
      "value": "1"
    },
    {
      "key": "replyMessageId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. 채팅방 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 10,\n  \"buyerId\": 1,\n  \"sellerId\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [{
        "listen": "test",
        "script": {"type": "text/javascript", "exec": [
          "pm.test('방 생성 또는 기존 방 반환', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
          "pm.collectionVariables.set('roomId', pm.response.json().id);"
        ]}
      }]
    },
    {
      "name": "2. 구매자 메시지 전송",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": 1,\n  \"content\": \"아직 판매 중인가요?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. 판매자 답장",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": 2,\n  \"content\": \"네, 판매 중입니다.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [{
        "listen": "test",
        "script": {"type": "text/javascript", "exec": [
          "pm.test('판매자 답장 생성', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('replyMessageId', pm.response.json().id);"
        ]}
      }]
    },
    {
      "name": "4. 판매자로 대화 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages?memberId=2"
      }
    },
    {
      "name": "5. 비참여자 조회 거절 (403)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages?memberId=3"
      }
    },
    {
      "name": "6. 빈 메시지 거절 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": 1,\n  \"content\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. 내 채팅방과 안 읽은 수",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms?memberId=1",
        "header": []
      }
    },
    {
      "name": "8. 읽음 처리",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/read-position",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberId\": 1,\n  \"lastReadMessageId\": {{replyMessageId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. 내 읽은 위치",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/read-position?memberId=1",
        "header": []
      }
    },
    {
      "name": "10. 상대 읽은 위치",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}/read-position/peer?memberId=2",
        "header": []
      }
    },
    {
      "name": "11. 방 상세 (참여자 검사)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/rooms/{{roomId}}?memberId=1",
        "header": []
      }
    }
  ]
}
